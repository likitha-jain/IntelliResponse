# IntelliResponse Configuration

# Hindsight Cloud or Local Instance
# Get credits on https://ui.hindsight.vectorize.io using code MEMHACK99
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK=intelliresponse-local

# Fast LLM for incident summaries (Groq free tier)
# https://groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3-32b

# Optional: AlienVault OTX for live IP reputation
OTX_API_KEY=

# Required only when running api.py as a network service. Must be 32+ characters; the
# placeholder below is REJECTED at startup. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IR_API_KEY=
# Max API requests per minute per client IP (a gateway should also rate-limit).
# IR_RATE_LIMIT=60
# Optional password gate for the Streamlit UI (use SSO / a reverse proxy for real exposure).
# IR_UI_PASSWORD=
# Cap on stored memory records (oldest dropped first).
# IR_MAX_RECORDS=5000
# Allow outbound OSINT lookups when a client asks for them (off by default).
# IR_LIVE_OSINT=0
# Plain-HTTP endpoints are rejected except for localhost; override only on trusted networks.
# IR_ALLOW_INSECURE_URLS=0
# Optional comma-separated exact browser origins; leave empty if no browser client is used.
IR_CORS_ORIGINS=
# Optional local memory path; keep outside version control.
# IR_STORE_PATH=./.ir_store.json
